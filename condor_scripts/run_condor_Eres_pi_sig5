# argumets: energy, board, layer, seed
arguments = "$(E) $(B) $(L) $(S)" 

# loop through energies in list: 
E = $CHOICE(STEP,1, 2, 5, 10, 15, 20, 25, 30, 40, 50, 70, 90, 100)

# queue jobs for N energies (number of energies in list), each with a given combo of board+layer+seed
# this will submit 5*13=65 jobs to condor
queue 13 B, L, S from (
D, 34, 1
D, 34, 2
D, 34, 3
D, 34, 4
D, 34, 5
)

